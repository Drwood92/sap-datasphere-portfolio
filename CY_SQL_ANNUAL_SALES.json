{
  "definitions": {
    "CY_SQL_ANNUAL_SALES": {
      "kind": "entity",
      "elements": {
        "Year": {
          "@EndUserText.label": "CALYEAR",
          "type": "cds.String",
          "length": 4
        },
        "Currency": {
          "@EndUserText.label": "DOC_CURRCY",
          "type": "cds.String",
          "length": 5
        },
        "Net_Value": {
          "@EndUserText.label": "Net_Value",
          "precision": 18,
          "scale": 2,
          "type": "cds.Decimal"
        }
      },
      "query": {
        "SELECT": {
          "from": {
            "join": "inner",
            "args": [
              {
                "ref": [
                  "CY_TAB_SALESHEAD"
                ],
                "as": "HEAD"
              },
              {
                "ref": [
                  "CY_TAB_SALESITEM"
                ],
                "as": "ITEM"
              }
            ],
            "on": [
              {
                "ref": [
                  "HEAD",
                  "DOC_NUMBER"
                ]
              },
              "=",
              {
                "ref": [
                  "ITEM",
                  "DOC_NUMBER"
                ]
              }
            ]
          },
          "columns": [
            {
              "ref": [
                "HEAD",
                "CALYEAR"
              ],
              "as": "Year"
            },
            {
              "ref": [
                "ITEM",
                "DOC_CURRCY"
              ],
              "as": "Currency"
            },
            {
              "func": "SUM",
              "args": [
                {
                  "ref": [
                    "ITEM",
                    "NET_VALUE"
                  ]
                }
              ],
              "as": "Net_Value"
            }
          ],
          "groupBy": [
            {
              "ref": [
                "HEAD",
                "CALYEAR"
              ]
            },
            {
              "ref": [
                "ITEM",
                "DOC_CURRCY"
              ]
            }
          ],
          "where": [
            {
              "ref": [
                "HEAD",
                "DOC_TYPE"
              ]
            },
            "=",
            {
              "val": "TA"
            }
          ]
        }
      },
      "@ObjectModel.supportedCapabilities": [
        {
          "#": "DATA_STRUCTURE"
        }
      ],
      "@EndUserText.label": "Annual Sales",
      "@ObjectModel.modelingPattern": {
        "#": "DATA_STRUCTURE"
      },
      "@DataWarehouse.consumption.external": false,
      "@DataWarehouse.sqlEditor.query": " SELECT \"HEAD\".\"CALYEAR\" AS \"Year\", \n        \"ITEM\".\"DOC_CURRCY\" AS \"Currency\",\n        SUM(\"ITEM\".\"NET_VALUE\") AS \"Net_Value\"\n FROM \"CY_TAB_SALESHEAD\" AS \"HEAD\"\n JOIN \"CY_TAB_SALESITEM\" AS \"ITEM\"\n ON \"HEAD\".\"DOC_NUMBER\" = \"ITEM\".\"DOC_NUMBER\"\n WHERE \"HEAD\".\"DOC_TYPE\" = 'TA'\n GROUP BY \"HEAD\".\"CALYEAR\",\n          \"ITEM\".\"DOC_CURRCY\"",
      "_meta": {
        "dependencies": {
          "folderAssignment": "Folder_JABIVHZX"
        }
      }
    },

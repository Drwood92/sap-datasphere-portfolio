      },
      "query": {
        "SELECT": {
          "from": {
            "join": "inner",
            "args": [
              {
                "ref": [
                  "CY_TAB_SALESHEAD"
                ],
                "as": "H"
              },
              {
                "ref": [
                  "CY_TAB_SALESITEM"
                ],
                "as": "I"
              }
            ],
            "on": [
              {
                "ref": [
                  "H",
                  "DOC_NUMBER"
                ]
              },
              "=",
              {
                "ref": [
                  "I",
                  "DOC_NUMBER"
                ]
              }
            ]
          },
          "columns": [
            {
              "ref": [
                "H",
                "DOC_NUMBER"
              ],
              "as": "Doc_Number"
            },
            {
              "ref": [
                "I",
                "S_ORD_ITEM"
              ],
              "as": "S_Ord_Item"
            },
            {
              "ref": [
                "H",
                "DOC_TYPE"
              ],
              "as": "Doc_Type"
            },
            {
              "ref": [
                "H",
                "SALESORG"
              ],
              "as": "Sales_Org"
            },
            {
              "ref": [
                "I",
                "MATERIAL"
              ],
              "as": "Material"
            },
            {
              "ref": [
                "I",
                "CML_OR_QTY"
              ],
              "as": "Quantity"
            },
            {
              "ref": [
                "I",
                "SALES_UNIT"
              ],
              "as": "Unit"
            },
            {
              "ref": [
                "I",
                "NET_VALUE"
              ],
              "as": "Net_Value"
            },
            {
              "ref": [
                "I",
                "COST"
              ],
              "as": "Cost"
            },
            {
              "xpr": [
                {
                  "ref": [
                    "I",
                    "NET_VALUE"
                  ]
                },
                "-",
                {
                  "ref": [
                    "I",
                    "COST"
                  ]
                }
              ],
              "as": "Margin"
            },
            {
              "ref": [
                "I",
                "DOC_CURRCY"
              ],
              "as": "Currency"
            },
            {
              "ref": [
                "H",
                "CALDAY"
              ],
              "as": "Cal_Day"
            },
            {
              "ref": [
                "H",
                "CALYEAR"
              ],
              "as": "Cal_Year"
            },
            {
              "ref": [
                "H",
                "CUSTOMER"
              ],
              "as": "Customer"
            }
          ],
          "where": [
            {
              "ref": [
                "H",
                "DOC_TYPE"
              ]
            },
            "=",
            {
              "val": "TA"
            }
          ]
        }
      },
      "@EndUserText.label": "SALES FACT SQL CY",
      "@ObjectModel.modelingPattern": {
        "#": "ANALYTICAL_FACT"
      },
      "@ObjectModel.supportedCapabilities": [
        {
          "#": "DATA_STRUCTURE"
        }
      ],
      "@DataWarehouse.consumption.external": false,
      "@DataWarehouse.sqlEditor.query": "SELECT \"H\".\"DOC_NUMBER\"  AS \"Doc_Number\",\n       \"I\".\"S_ORD_ITEM\"  AS \"S_Ord_Item\",\n       \"H\".\"DOC_TYPE\"    AS \"Doc_Type\",\n       \"H\".\"SALESORG\"    AS \"Sales_Org\",\n       \"I\".\"MATERIAL\"    AS \"Material\",\n       \"I\".\"CML_OR_QTY\"  AS \"Quantity\",\n       \"I\".\"SALES_UNIT\"  AS \"Unit\",\n       \"I\".\"NET_VALUE\"   AS \"Net_Value\",\n       \"I\".\"COST\"        AS \"Cost\",\n       \"I\".\"NET_VALUE\" - \"I\".\"COST\" AS \"Margin\",\n       \"I\".\"DOC_CURRCY\"  AS \"Currency\",\n       \"H\".\"CALDAY\"      AS \"Cal_Day\",\n       \"H\".\"CALYEAR\"     AS \"Cal_Year\",\n       \"H\".\"CUSTOMER\"    AS \"Customer\"\nFROM \"CY_TAB_SALESHEAD\" AS \"H\"\nINNER JOIN \"CY_TAB_SALESITEM\" AS \"I\"\n  ON \"H\".\"DOC_NUMBER\" = \"I\".\"DOC_NUMBER\"\nWHERE \"H\".\"DOC_TYPE\" = 'TA'",
      "_meta": {
        "dependencies": {
          "folderAssignment": "Folder_JABIVHZX"
        }
      }
    },
